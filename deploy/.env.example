# Copie para .env e preencha. O .env nunca vai para o git.

# Endereço público do cofre (o que as pessoas digitam no navegador)
PUBLIC_URL=https://cofre.exemplo.com.br
# Fixe uma versão (ex.: 5.x.y-1-ce) e só suba depois de ler o changelog
PASSBOLT_TAG=latest-ce

# Banco (gere com: openssl rand -base64 24)
DB_PASSWORD=

# SMTP para os convites e avisos
SMTP_FROM=cofre@exemplo.com.br
SMTP_FROM_NAME=Eurydice
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Provedor de identidade (OIDC): Google, Microsoft Entra, Keycloak, Authentik...
# Redirect URI a cadastrar no provedor: ${PUBLIC_URL}/oauth2/callback
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# gere com: openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=
COOKIE_EXPIRE=12h

# Onde a borda escuta (coloque um terminador TLS na frente)
EDGE_BIND=127.0.0.1:4180
# true se houver um proxy reverso na frente repassando X-Forwarded-*
BEHIND_PROXY=true

# eurydice-sync
SYNC_PROTECTED=custodia@exemplo.com.br
SYNC_MAX_CHANGES=3
SYNC_APPLY=false

BRAND_TITLE=Eurydice | Cofre de senhas
